# Copy to .env and fill in values before running `docker compose up`.

# Required. JWT signing secret — must be at least 32 characters.
# Generate one with: openssl rand -base64 48
LUMINA_JWT_KEY=

# Optional. Finnhub API key for stock/ETF live prices (free tier: ~60 calls/min).
# Leave blank to disable stock price refresh.
LUMINA_FINNHUB_KEY=

# Optional. Host port nginx binds to. Defaults to 8080.
LUMINA_WEB_PORT=8080
