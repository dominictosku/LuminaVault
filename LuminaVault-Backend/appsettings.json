{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lumina-vault",
    "Audience": "lumina-vault",
    "Key": "",
    "ExpiryHours": 720
  },
  "Setup": {
    "RegistrationSecret": "",
    "RequireRegistrationSecretOutsideDevelopment": true
  },
  "PriceProviders": {
    "CoinGecko": {
      "ApiKey": ""
    },
    "Finnhub": {
      "ApiKey": ""
    }
  },
  "Backup": {
    "Enabled": false,
    "Directory": "backups",
    "IntervalHours": 24,
    "RetainedFiles": 14
  },
  "SubscriptionAutomation": {
    "Enabled": false,
    "LookAheadDays": 7,
    "IntervalHours": 24
  }
}
